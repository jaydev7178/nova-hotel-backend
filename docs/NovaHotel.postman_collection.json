{
  "info": {
    "name": "Nova Hotel API Collection",
    "description": "Complete API test collection for Nova Hotel system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('retryCount', 0);",
                  "pm.environment.set('userEmail', pm.variables.replaceIn('{{$randomEmail}}'));",
                  "console.log('Starting registration with email:', pm.environment.get('userEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-REG-01: Registration Successful', () => {",
                  "    const maxRetries = 2;",
                  "    const response = pm.response.json();",
                  "",
                  "    if (pm.response.code === 201 && response.id) {",
                  "        pm.environment.set('userId', response.id);",
                  "        console.log('Registration successful. User ID:', response.id);",
                  "    } else {",
                  "        const retryCount = parseInt(pm.environment.get('retryCount')) || 0;",
                  "        if (retryCount < maxRetries) {",
                  "            pm.environment.set('retryCount', retryCount + 1);",
                  "            pm.environment.set('userEmail', pm.variables.replaceIn('{{$randomEmail}}'));",
                  "            console.log(`Registration failed. Retrying with new email: ${pm.environment.get('userEmail')}`);",
                  "            postman.setNextRequest('Register User');",
                  "        } else {",
                  "            throw new Error('Registration failed after maximum retries');",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('retryCount', 0);",
                  "console.log('Attempting login with email:', pm.environment.get('userEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-LOG-01: Login Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    if (pm.response.code === 200 && response.token) {",
                  "        pm.environment.set('userToken', response.token);",
                  "        console.log('Login successful. Token received.');",
                  "    } else {",
                  "        const retryCount = parseInt(pm.environment.get('retryCount')) || 0;",
                  "        if (retryCount < 2) {",
                  "            pm.environment.set('retryCount', retryCount + 1);",
                  "            console.log('Login failed. Retrying registration...');",
                  "            postman.setNextRequest('Register User');",
                  "        } else {",
                  "            throw new Error('Login failed after retries');",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Get Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-PROD-01: Get Products Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    if (response.products && response.products.length > 0) {",
                  "        pm.environment.set('productId', response.products[0].id);",
                  "        console.log('Products retrieved. Selected product:', response.products[0].id);",
                  "    } else {",
                  "        console.log('No products found. Initiating product creation via admin...');",
                  "        postman.setNextRequest('Admin Login');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Product Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-PROD-02: Get Product Details Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('name');",
                  "    pm.expect(response).to.have.property('price');",
                  "",
                  "    if (pm.response.code !== 200) {",
                  "        console.log('Product not found. Fetching new product list...');",
                  "        postman.setNextRequest('Get Products');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Cart",
      "item": [
        {
          "name": "Add to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-CART-01: Add to Cart Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    if (pm.response.code === 200 && response.cartId) {",
                  "        pm.environment.set('cartId', response.cartId);",
                  "        console.log('Product added to cart. Cart ID:', response.cartId);",
                  "    } else {",
                  "        console.log('Failed to add to cart. Verifying product...');",
                  "        postman.setNextRequest('Get Product Details');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/add",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-ORD-01: Create Order Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    if (pm.response.code === 201 && response.orderId) {",
                  "        pm.environment.set('orderId', response.orderId);",
                  "        console.log('Order created. Order ID:', response.orderId);",
                  "    } else {",
                  "        console.log('Order creation failed. Verifying cart...');",
                  "        postman.setNextRequest('Add to Cart');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cartId\": \"{{cartId}}\",\n    \"shippingAddress\": {\n        \"street\": \"123 Test St\",\n        \"city\": \"Test City\",\n        \"zipCode\": \"12345\"\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Check Order Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-ORD-02: Check Order Status Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response).to.have.property('orderId');",
                  "    pm.expect(response).to.have.property('status');",
                  "",
                  "    if (pm.response.code !== 200) {",
                  "        console.log('Order not found. Verifying order ID...');",
                  "        postman.setNextRequest('Create Order');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-ADM-01: Admin Login Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    if (pm.response.code === 200 && response.token) {",
                  "        pm.environment.set('adminToken', response.token);",
                  "        console.log('Admin login successful');",
                  "    } else {",
                  "        throw new Error('Admin login failed. Check credentials.');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "login"]
            }
          }
        },
        {
          "name": "Approve Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-ADM-02: Order Approval Successful', () => {",
                  "    if (pm.response.code !== 200) {",
                  "        console.log('Order approval failed. Refreshing admin token...');",
                  "        postman.setNextRequest('Admin Login');",
                  "    } else {",
                  "        console.log('Order approved successfully');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "{{orderId}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Integration Tests",
      "item": [
        {
          "name": "Complete Order Flow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-INT-01: Complete Order Flow Successful', () => {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.status).to.equal('CONFIRMED');",
                  "    pm.expect(response.userNotified).to.be.true;",
                  "",
                  "    if (pm.response.code !== 200) {",
                  "        console.log('Integration test failed. Restarting flow...');",
                  "        postman.setNextRequest('Register User');",
                  "    } else {",
                  "        console.log('Integration test completed successfully');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "console.log('Test run started at:', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "console.log('Test completed at:', new Date().toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    }
  ]
}