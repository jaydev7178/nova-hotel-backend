    "item": [
        {
            "name": "1. Authentication",
            "description": "Authentication and user management endpoints",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.environment.set('retryCount', 0);",
                                    "pm.environment.set('userEmail', pm.variables.replaceIn('{{$randomEmail}}'));",
                                    "pm.environment.set('username', pm.variables.replaceIn('user_{{$randomUserName}}'));",
                                    "console.log('Starting registration with:', {",
                                    "    email: pm.environment.get('userEmail'),",
                                    "    username: pm.environment.get('username')",
                                    "});"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('TC-REG-01: Registration Response Structure', () => {",
                                    "    const response = pm.response.json();",
                                    "",
                                    "    pm.expect(response).to.have.property('success');",
                                    "    pm.expect(response).to.have.property('message');",
                                    "    pm.expect(response).to.have.property('data');",
                                    "",
                                    "    if (response.data) {",
                                    "        pm.expect(response.data).to.have.property('token');",
                                    "        pm.expect(response.data).to.have.property('user');",
                                    "        pm.expect(response.data.user).to.have.property('id');",
                                    "    }",
                                    "});",
                                    "",
                                    "pm.test('TC-REG-02: Registration Success', () => {",
                                    "    const maxRetries = 2;",
                                    "    const response = pm.response.json();",
                                    "",
                                    "    if (pm.response.code === 201 && response.success) {",
                                    "        pm.environment.set('userId', response.data.user.id);",
                                    "        pm.environment.set('userToken', response.data.token);",
                                    "        console.log('Registration successful. User ID:', response.data.user.id);",
                                    "    } else {",
                                    "        const retryCount = parseInt(pm.environment.get('retryCount')) || 0;",
                                    "        if (retryCount < maxRetries) {",
                                    "            pm.environment.set('retryCount', retryCount + 1);",
                                    "            pm.environment.set('userEmail', pm.variables.replaceIn('{{$randomEmail}}'));",
                                    "            pm.environment.set('username', pm.variables.replaceIn('user_{{$randomUserName}}'));",
                                    "            console.log(`Registration failed. Retrying with new credentials`);",
                                    "            postman.setNextRequest('Register User');",
                                    "        } else {",
                                    "            throw new Error('Registration failed after maximum retries');",
                                    "        }",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"{{username}}\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"phoneNumber\": \"1234567890\",\n    \"address\": \"123 Test St, Test City\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login User",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.environment.set('retryCount', 0);",
                                    "console.log('Attempting login with username:', pm.environment.get('username'));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('TC-LOG-01: Login Response Structure', () => {",
                                    "    const response = pm.response.json();",
                                    "    ",
                                    "    pm.expect(response).to.have.property('success');",
                                    "    pm.expect(response).to.have.property('message');",
                                    "    pm.expect(response).to.have.property('data');",
                                    "    ",
                                    "    if (response.data) {",
                                    "        pm.expect(response.data).to.have.property('token');",
                                    "        pm.expect(response.data).to.have.property('user');",
                                    "    }",
                                    "});",
                                    "",
                                    "pm.test('TC-LOG-02: Login Success', () => {",
                                    "    const response = pm.response.json();",
                                    "",
                                    "    if (pm.response.code === 200 && response.success) {",
                                    "        pm.environment.set('userToken', response.data.token);",
                                    "        console.log('Login successful. Token received.');",
                                    "    } else {",
                                    "        const retryCount = parseInt(pm.environment.get('retryCount')) || 0;",
                                    "        if (retryCount < 2) {",
                                    "            pm.environment.set('retryCount', retryCount + 1);",
                                    "            console.log('Login failed. Retrying registration...');",
                                    "            postman.setNextRequest('Register User');",
                                    "        } else {",
                                    "            throw new Error('Login failed after retries');",
                                    "        }",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"usernameOrEmail\": \"{{username}}\",\n    \"password\": \"{{userPassword}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
